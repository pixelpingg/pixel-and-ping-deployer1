{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixel-and-ping-deployer1",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "src/migrations/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOBS",
        "class_name": "DeployJob"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeployJob"
      ]
    }
  ]
}
